# Copy to users_database.yml (gitignored) and replace the hash.
# Generate a hash:
#   docker run --rm authelia/authelia:4.39.28 \
#     authelia crypto hash generate argon2 --password 'YOUR_PASSWORD'
users:
    rule:
        disabled: false
        displayname: 'Rule'
        password: '$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_HASH'
        email: 'admin@example.com'
        groups:
            - 'admins'