{
	metrics
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(compression) {
	encode zstd gzip
}

(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

(logging) {
	log {
		output stdout
		format json
	}
}

(tls_porkbun) {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_API_SECRET_KEY}
		}
		resolvers 1.1.1.1 9.9.9.9
		propagation_delay 2m
		propagation_timeout 10m
	}
}

*.home.rusak.eu {
	import tls_porkbun
	import secure_headers
	import logging
	import compression

	@auth host auth.home.rusak.eu
	handle @auth {
		reverse_proxy authelia:9091
	}

	@kuma host kuma.home.rusak.eu
	handle @kuma {
		import authelia
		reverse_proxy uptime-kuma:3001
	}

	@dns host dns.home.rusak.eu
	handle @dns {
		import authelia
		reverse_proxy technitium:5380
	}

	@beszel host beszel.home.rusak.eu
	handle @beszel {
		reverse_proxy beszel:8090
	}

	handle {
		abort
	}
}

:2020 {
	metrics /metrics
}
